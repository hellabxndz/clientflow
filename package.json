{
  "name": "clientflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "jobs:reminders": "tsx scripts/run-reminders.ts",
    "jobs:retention": "tsx scripts/run-retention.ts",
    "jobs:tick": "tsx scripts/run-automations.ts",
    "test": "vitest run",
    "screenshots": "tsx scripts/screenshots.ts",
    "e2e": "tsx scripts/e2e-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.6",
    "lucide-react": "^1.52.0",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
