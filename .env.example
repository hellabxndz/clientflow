# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clientflow
APP_URL=http://localhost:3000
# Long random string. Signs short-lived download links. The app refuses to start in production without it.
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32
# Private file storage, outside the web root. Not served directly.
STORAGE_DIR=./storage
# Encrypts integration credentials (AES-256-GCM). At least 32 characters. Falls back to a key derived from
# SESSION_SECRET if unset; set it explicitly before storing real CRM or Slack credentials.
INTEGRATION_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32

# Email (Resend). Without these, non-demo workspaces log reminders as "failed: not configured".
# Demo workspaces never send real email, whatever is set here.
RESEND_API_KEY=
EMAIL_FROM="ClientFlow <onboarding@yourdomain.com>"
# Set to true to simulate every email in every workspace (staging).
DISABLE_EMAIL_SENDING=false

# AI assistant (optional). Without a key the assistant uses rule-based summaries and drafts.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Malware scanning (optional). Without it, uploads are stored as "Not scanned" and flagged in the UI.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Protects the scheduled-job endpoints (/api/cron/tick runs automations, escalations and reminders;
# /api/cron/reminders runs reminders only). Call /api/cron/tick every 5-15 minutes with
# "Authorization: Bearer $CRON_SECRET", or run `npm run jobs:tick` from cron. At least 24 characters.
CRON_SECRET=

# Invitation lifetime in hours (default 7 days).
INVITE_TTL_HOURS=168
# Hide the demo sign-in shortcuts on the login page.
SHOW_DEMO_LOGINS=true

# Tests use a separate database that they reset on every run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/clientflow_test
